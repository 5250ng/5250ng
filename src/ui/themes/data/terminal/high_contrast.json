{
    "id": "high_contrast",
    "displayName": "High Contrast",
    "builtin": true,
    "background": {
        "mode": "color",
        "color": "#000000",
        "imageLayout": "stretch",
        "imageOpacity": 1.0
    },
    "font": {
        "family": "IBM 3270",
        "size": 16
    },
    "colors": {
        "black":  "#000000",
        "green":  "#00ff00",
        "white":  "#ffffff",
        "blue":   "#6060ff",
        "red":    "#ff0000",
        "cyan":   "#00ffff",
        "pink":   "#ff00ff",
        "yellow": "#ffff00",
        "cursor": "#ffffff"
    },
    "selection": {
        "background": "#ffffff60",
        "foreground": "#000000",
        "fieldIndicator": "#ffff0050"
    },
    "columnSeparator": {
        "color": "#ffffff",
        "style": "solid"
    },
    "cursor": {
        "shape": "block",
        "blinkMs": 400
    },
    "crtEffect": {
        "enabled": false,
        "scanlineIntensity": 0.0,
        "glowRadius": 0.0,
        "curvature": 0.0
    },
    "globalBrightness": 1.2,
    "globalSaturation": 1.3
}
