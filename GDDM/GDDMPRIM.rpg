     I                                    B  17  200ITYPE
     I                                    B  21  240IWIDE
     I                                    B  25  280IDEEP
     I                                    B  29  320ILEN
     I                                    B  33  360ATTYPE
     I                                    B  37  400ATMOD
     I                                    B  41  440COUNT
     C                     CALL 'GDDM'
     C                     PARM 'FSINIT ' RTN     8
     C                     CALL 'GDDM'
